# Copy to .env (already ignored by git) or export in your shell.
# Values are read by scripts/env_value() which checks the environment first,
# then a .env file next to the script or at the repository root.

# Optional identifiers for polite use of NCBI E-utilities (PubMed).
NCBI_EMAIL=you@example.com
NCBI_API_KEY=replace-with-your-key

# Optional identifiers for OpenAlex and Crossref (helpful, not required).
OPENALEX_EMAIL=you@example.com
OPENALEX_API_KEY=replace-with-your-key
CROSSREF_EMAIL=you@example.com

# Optional paid third-party APIs.
TIKHUB_API_KEY=replace-with-your-key
TIKHUB_BASE_URL=https://api.tikhub.io

# Optional local reranking via the SiliconFlow rerank API.
SILICONFLOW_API_KEY=replace-with-your-key
SILICONFLOW_RERANK_ENDPOINT=https://api.siliconflow.cn/v1/rerank
